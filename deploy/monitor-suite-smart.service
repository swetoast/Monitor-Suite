[Unit]
Description=Monitor Suite SMART collector

[Service]
Type=oneshot
User=root
Group=monitor-suite
RuntimeDirectory=monitor-suite-agent
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
WorkingDirectory=/opt/monitor-suite-agent
EnvironmentFile=/etc/monitor-suite-agent.env
ExecStart=/opt/monitor-suite-agent/.venv/bin/monitor-suite-smart-collector
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
